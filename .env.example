# ------------------------------------------------------------
# Club & Committee Management Portal - environment settings
# Copy this file to ".env" and change the values.
# NEVER commit your real .env file to Git.
# ------------------------------------------------------------

APP_NAME="Club & Committee Portal"
# development shows friendly error pages + logs details; production hides everything
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
# Full URL of the public/ folder (used in password-reset emails)
APP_URL=http://localhost:8000
# Allow students to create their own (non-admin) account from the login page
ALLOW_REGISTRATION=true
CURRENCY_SYMBOL=₹

# ---------------- MongoDB ----------------
# Local MongoDB Community Server:
MONGO_URI=mongodb://127.0.0.1:27017
# MongoDB Atlas example (replace placeholders):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_DB=club_portal
# Separate database used by the automated tests (it is wiped by the tests!)
MONGO_DB_TEST=club_portal_test

# ---------------- Session ----------------
# Minutes of inactivity before the user is logged out
SESSION_IDLE_MINUTES=30
# Set to true when the site is served over HTTPS
SESSION_SECURE_COOKIE=false

# ---------------- Uploads ----------------
MAX_UPLOAD_MB=5

# ---------------- Email (optional) ----------------
# Leave SMTP_HOST empty to disable email (forgot-password then shows
# "contact the administrator" and notifications stay in-app only).
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS on 587), ssl (port 465) or none
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Club Portal"
