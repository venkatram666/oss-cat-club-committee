{
    "name": "student/club-committee-portal",
    "description": "Club & Committee Management Portal built with PHP and MongoDB",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-mongodb": "^1.20",
        "mongodb/mongodb": "^1.20"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" },
        "files": ["app/Helpers/functions.php"]
    },
    "scripts": {
        "setup-db": "php scripts/create_indexes.php",
        "seed": "php scripts/seed.php",
        "test": "php tests/run_tests.php"
    },
    "config": { "sort-packages": true }
}
